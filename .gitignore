# Dependencies (this plugin has none, but installs may create them)
node_modules/
.pnpm-store/

# Test / build noise
coverage/
*.tsbuildinfo

# Python bytecode from the SCI skill's scripts
__pycache__/
*.py[cod]
.venv/
venv/

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local secrets. The MinerU token belongs in the environment, never in the repo.
.env
.env.*
!.env.example

# Local scratch: rendered previews, deck projects, downloaded archives.
# Never commit generated slide output or preview SVGs.
previews/
*.pptx
*.zip
projects/

# `skills/ppt-master` is a link into the upstream submodule, created by
# `npm run upstream:init` so that every skill lives in one directory. It is
# generated, and the files belong to the submodule — committing it would both
# duplicate upstream and turn the fast-forward sync into a conflict.
skills/ppt-master

# upstream.lock.json is deliberately NOT ignored: the pinned commit is part of
# the contract and must be reviewable in the diff of every sync.
