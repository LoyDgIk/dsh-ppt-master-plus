# Copy to `.env` and fill in. Never commit the real file.
#
# The SCI skill's MinerU ingestion reads these. An already-exported environment
# variable always wins over this file, so CI secrets are not shadowed by a
# stray .env.
#
# Get a token from https://mineru.net
MINERU_API_TOKEN=

# Optional: point at a different MinerU-compatible endpoint.
# MINERU_API_BASE_URL=https://mineru.net/api/v4

# Optional: pin the TeX compiler used by latex_preview.py (preview only).
# PPT_MASTER_TEX_COMPILER=latex
# Optional: explicit path to dvisvgm.
# PPT_MASTER_DVISVGM=

# Optional: use a ppt-master checkout outside this package
# (a developer working copy, a shared install, a CI cache).
# DSH_PPT_MASTER_PLUS_UPSTREAM=
